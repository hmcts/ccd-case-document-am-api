#!groovy

import groovy.json.JsonOutput
import uk.gov.hmcts.contino.GithubAPI

properties([
  // H allow predefined but random minute see https://en.wikipedia.org/wiki/Cron#Non-standard_characters
  //CCD-3539 (Stop running Nightly builds on weekends). Original schedule was 'H 05 * * *'
  pipelineTriggers([cron('H 07 * * 1-5')])
])

@Library("Infrastructure@cve-dashboard")

def type = "java"
def product = "ccd"
def component = "case-document-am-api"

// Prevent Docker hub rate limit errors by ensuring that testcontainers uses images from hmctsprod ACR
env.TESTCONTAINERS_HUB_IMAGE_NAME_PREFIX = "hmctsprod.azurecr.io/imported/"

withNightlyPipeline(type, product, component) {
  enableSlackNotifications('#ccd-case-document-am-api-builds')
  enableFortifyScan()
  afterAlways('fortify-scan') {
    steps.archiveArtifacts allowEmptyArchive: true, artifacts: '**/Fortify Scan/**/*'
  }

  afterAlways('DependencyCheckNightly') {
    stage('Suppress and Send Slack Notification') {
      script {
        if (env.CHANGE_ID) {
          echo "This is a PR: #${env.CHANGE_ID}"
          echo "Source branch: ${env.CHANGE_BRANCH}"
          echo "Target branch: ${env.CHANGE_TARGET}"
        } else {
          echo "Not a pull request: branch ${env.BRANCH_NAME}"
        }
      }

      def suppressionFile = ''
      def baselineSuppressionFile = 'build/cve-suppression-baseline.xml'
      def validatedCvesFile = 'build/validated-cve-suppressions.txt'
      def slackNotificationChannel = '#nightly_cve_suppressions'
      def credentialsId = env.GIT_CREDENTIALS_ID
      def targetBranch = 'master'

      withCredentials([
        gitUsernamePassword(credentialsId: credentialsId, gitToolName: 'Default')
      ]) {
        sh "git fetch origin +refs/heads/${targetBranch}:refs/remotes/origin/${targetBranch}"
      }

      script {
        def suppressionOutput = sh(
          script: './gradlew printSuppressionFile -q',
          returnStdout: true
        ).trim()

        suppressionFile = suppressionOutput
          .readLines()
          .find { it.startsWith('SUPPRESSION_FILE=') }
          ?.split('=', 2)[1]
          ?.trim()

        if (!suppressionFile) {
          error "Failed to resolve suppression file path from printSuppressionFile output: ${suppressionOutput}"
        }

        def masterSuppression = sh(
          script: "git show origin/${targetBranch}:${suppressionFile}",
          returnStdout: true
        )
        writeFile(file: suppressionFile, text: masterSuppression)
        writeFile(file: baselineSuppressionFile, text: masterSuppression)

        echo "Suppression file and path: ${suppressionFile}"
      }

      sh './gradlew suppressCves'

      def changedFiles = []
      def suppressionChanged = false

      script {
        def workspaceChangedFiles = sh(
          script: 'git diff HEAD --name-only',
          returnStdout: true
        ).trim().readLines().findAll { it?.trim() }
        def unexpectedChangedFiles = workspaceChangedFiles.findAll { it != suppressionFile }
        if (unexpectedChangedFiles) {
          error("CVE suppression generation changed unexpected files: ${unexpectedChangedFiles}")
        }

        if (readFile(file: baselineSuppressionFile) != readFile(file: suppressionFile)) {
          changedFiles = [suppressionFile]
          suppressionChanged = true
          echo 'Only the suppression file changed. Proceeding.'
        } else {
          echo 'Suppression file did not change.'
        }
      }

      if (suppressionChanged && env.CHANGE_ID) {
        echo 'CVE suppression changes detected during PR validation; skipping automated PR creation.'
      } else if (suppressionChanged) {
        sh(
          script: "./gradlew validateGeneratedCveSuppressions "
            + "-PbaselineSuppressionFile=${baselineSuppressionFile} "
            + "-PvalidatedCvesOutput=${validatedCvesFile}"
        )

        def newCves = readFile(file: validatedCvesFile)
          .readLines()
          .collect { it.trim() }
          .findAll { it }
        def formattedCves = newCves.collect { "- `${it}`" }.join('\n')

        echo "Staged files: ${changedFiles}"
        echo "New CVEs: ${newCves}"

        def automationBranch = "automated/cve-suppressions-${env.BUILD_NUMBER}"
        def automationWorkspace = "${pwd(tmp: true)}/cve-suppressions-${env.BUILD_NUMBER}"
        def githubProject = new GithubAPI(this).currentProject()
        def generatedSuppression = readFile(file: suppressionFile)

        echo "Creating ${automationBranch} from origin/${targetBranch}"
        sh "git worktree add --no-track -b '${automationBranch}' '${automationWorkspace}' origin/${targetBranch}"
        try {
          writeFile(file: "${automationWorkspace}/${suppressionFile}", text: generatedSuppression)

          dir(automationWorkspace) {
            sh "git add -- '${suppressionFile}'"
            def automationChangedFiles = sh(
              script: 'git diff --cached --name-only',
              returnStdout: true
            ).trim().readLines()
            if (automationChangedFiles != [suppressionFile]) {
              error("Expected only ${suppressionFile} to change, found: ${automationChangedFiles}")
            }

            sh 'git commit -m "Suppressing CVE - Actions"'

            withCredentials([
              gitUsernamePassword(credentialsId: credentialsId, gitToolName: 'Default')
            ]) {
              sh "git push origin HEAD:refs/heads/${automationBranch}"
            }
          }
        } finally {
          sh(returnStatus: true, script: "git worktree remove --force '${automationWorkspace}'")
        }

        def pullRequestResponse = httpRequest(
          acceptType: 'APPLICATION_JSON',
          authentication: credentialsId,
          consoleLogResponseBody: false,
          contentType: 'APPLICATION_JSON',
          httpMode: 'POST',
          requestBody: JsonOutput.toJson([
            title: 'Suppress newly detected CVEs',
            head: automationBranch,
            base: targetBranch,
            body: "Automated CVE suppression update generated and validated by ${env.JOB_NAME} #${env.BUILD_NUMBER}."
          ]),
          url: "https://api.github.com/repos/${githubProject}/pulls",
          validResponseCodes: '201'
        )
        def pullRequest = readJSON returnPojo: true, text: pullRequestResponse.content
        def pullRequestNumber = pullRequest.number
        def pullRequestUrl = pullRequest.html_url
        def slackMessage = [
          '*ACTION REQUIRED: MANUAL MERGE NEEDED*',
          "*Merge PR #${pullRequestNumber} manually to fix the CVE suppression failure.*",
          '',
          "*New CVEs to suppress (${newCves.size()}):*",
          formattedCves,
          '',
          "*Pull request:* <${pullRequestUrl}|Open PR #${pullRequestNumber}>",
          "*Build:* <${env.BUILD_URL}|${env.JOB_NAME} #${env.BUILD_NUMBER}>"
        ].join('\n')

        slackSend(
          channel: slackNotificationChannel,
          color: 'danger',
          failOnError: true,
          message: slackMessage
        )
      } else {
        echo 'Suppression file did not change; skipping Slack notification.'
      }
    }
  }
}
